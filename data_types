var
- Function scoped.
- Allows redeclaration.
- Allows reassignment.
- Can be accessed throughout the function in which it is declared.

function demo(){
    var a = 10;
    var a = 10;
    a = 20;
}
demo()

let 
- block scoped { } - we can acess within the block
- allows reassignment
- redeclaration not allowed
- can acess within the block and cannot access outside
{
    let a = 10
    // let a = 20; // Error: already declared
    a = 20
    console.log(a)
}

const
- Block scoped.
- Does not allow redeclaration in the same scope.
- Does not allow reassignment.
- Accessible inside the block, not outside

{
    const a = 10;

    // const a = 20; // Error: redeclaration

    // a = 20; // Error: reassignment

    console.log(a);
}

